{{template "layout" .}}
{{define "content" -}}
<p style="margin:0 0 16px;">Hello {{.Data.UserName}},</p>
<p style="margin:0 0 16px;">
While you were away, <strong>{{.Data.TotalUnread}}</strong> thing{{if ne .Data.TotalUnread 1}}s{{end}}
came up in <strong>{{.Data.WorkspaceName}}</strong>.
</p>
<table role="presentation" cellpadding="0" cellspacing="0" style="width:100%;margin:0 0 16px;font-size:14px;color:#1d1c1d;">
{{range .Data.Items}}
<tr><td style="padding:8px 0;border-bottom:1px solid #e8e8e8;">
  <a href="{{$.URL .Link}}" style="color:#1264a3;text-decoration:none;font-weight:600;">{{.Title}}</a>
  {{if gt .UnreadCount 1}}<span style="color:#616061;">&nbsp;({{.UnreadCount}} new)</span>{{end}}
  {{if .Preview}}<div style="color:#616061;font-size:13px;margin-top:2px;">{{.Preview}}</div>{{end}}
</td></tr>
{{end}}
</table>
<p style="margin:0 0 16px;"><a href="{{.URL "/inbox"}}" style="color:#1264a3;">Open your inbox</a></p>
<p style="margin:0;color:#616061;font-size:13px;">
Change what you are emailed about in your
<a href="{{.URL "/settings/notifications"}}" style="color:#1264a3;">notification preferences</a>.
</p>
{{- end}}
