# SuperOps environment template.
#
# Do NOT copy this file by hand for anything but a throwaway laptop stack: every
# value below starting with `changeme_` is a placeholder. Run ../../scripts/setup.sh,
# which writes deploy/docker/.env with freshly generated random secrets.
#
# Empty string means "unset" everywhere in the loader (backend/internal/app/config.go),
# so `FOO=` does not disable FOO — it silently restores the built-in default.

# --- Server ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=15s
SERVER_IDLE_TIMEOUT=60s

# Interface the public web proxy binds to. Every other published port is pinned
# to 127.0.0.1 by docker-compose.yml.
FRONTEND_BIND=0.0.0.0

# --- Admin (required — seeds the first user on first boot) ---
ADMIN_EMAIL=admin@company.com
ADMIN_PASSWORD=changeme_admin_password
ADMIN_USERNAME=admin

# --- PostgreSQL ---
DB_HOST=postgres
DB_PORT=5432
DB_USER=superops
# DB_PASSWORD is what the app connects with; POSTGRES_PASSWORD is what the
# postgres container initialises the role with. They must be identical.
DB_PASSWORD=changeme_db_password
POSTGRES_PASSWORD=changeme_db_password
DB_NAME=superops
DB_SSLMODE=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5
DB_APPLICATION_NAME=superops
DB_STATEMENT_TIMEOUT=30s
DB_LOCK_TIMEOUT=5s
DB_IDLE_IN_TX_TIMEOUT=60s
# Full DSN override, wins over every DB_* above. Use it for a pooler
# (pgbouncer) or to add target_session_attrs. Leave unset for the values above.
#DATABASE_URL=postgres://superops:password@host:5432/superops?sslmode=require

# --- Redis ---
REDIS_ADDR=redis:6379
REDIS_PASSWORD=changeme_redis_password
REDIS_DB=0
REDIS_DIAL_TIMEOUT=2s
REDIS_READ_TIMEOUT=1s
REDIS_WRITE_TIMEOUT=1s
REDIS_POOL_SIZE=20

# --- NATS ---
# The NATS server runs with --user/--pass; docker-compose.yml builds NATS_URL
# from these two values, so do not set NATS_URL here.
NATS_USER=superops
NATS_PASSWORD=changeme_nats_password
NATS_DRAIN_TIMEOUT=10s

# --- JWT ---
JWT_SECRET=changeme_jwt_secret_at_least_32_chars_long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# --- MinIO (object storage for uploaded files) ---
# FILES_ENABLED=false is the supported way to turn uploads off; an empty
# MINIO_ENDPOINT is treated as unset and falls back to the default.
FILES_ENABLED=true
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=changeme_minio_password
MINIO_BUCKET=superops
MINIO_USE_SSL=false

# --- Meilisearch ---
# SEARCH_ENABLED=false is the supported way to turn search off.
SEARCH_ENABLED=true
MEILI_HOST=http://meilisearch:7700
MEILI_MASTER_KEY=changeme_meili_master_key

# --- CORS ---
# Comma-separated list of allowed browser origins. The default when unset is
# "*", which is wrong for any deployment that serves real users. The bundled
# web client is same-origin behind the nginx proxy, so the proxy origin is all
# you normally need.
CORS_ALLOWED_ORIGINS=http://localhost:8080

# --- Rate limiting ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_API_PER_MIN=600
RATE_LIMIT_AUTH_PER_MIN=10
# Honour X-Forwarded-For for the per-IP limits. ONLY safe when every request
# reaches the backend through a proxy that overwrites that header — i.e. the
# bundled nginx, with the backend port bound to loopback. Set to false if you
# expose the backend port directly, otherwise the login brute-force limit is
# bypassable by rotating the header.
RATE_LIMIT_TRUST_PROXY=true
# Number of trusted proxies in front of the app; the client IP is taken as the
# Nth entry from the RIGHT of X-Forwarded-For. The bundled stack is exactly one
# nginx hop. Only valid together with RATE_LIMIT_TRUST_PROXY=true.
RATE_LIMIT_TRUSTED_PROXY_HOPS=1

# --- Metrics ---
# When set, GET /metrics requires `Authorization: Bearer <token>`. Leave unset
# only on a host where nothing untrusted can reach the backend port. setup.sh
# also writes this value to deploy/docker/secrets/metrics_token for Prometheus.
METRICS_TOKEN=changeme_metrics_token

# --- Monitoring profile (docker compose --profile monitoring) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme_grafana_password

# --- Logging ---
LOG_LEVEL=info
