# SuperOps environment template.
#
# Do NOT copy this file by hand for anything but a throwaway laptop stack: every
# value below starting with `changeme_` is a placeholder. Run ../../scripts/setup.sh,
# which writes deploy/docker/.env with freshly generated random secrets.
#
# Empty string means "unset" everywhere in the loader (backend/internal/app/config.go),
# so `FOO=` does not disable FOO — it silently restores the built-in default.

# --- Server ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=15s
SERVER_IDLE_TIMEOUT=60s

# Interface the public web proxy binds to. Every other published port is pinned
# to 127.0.0.1 by docker-compose.yml.
FRONTEND_BIND=0.0.0.0

# --- Admin (required — seeds the first user on first boot) ---
ADMIN_EMAIL=admin@company.com
ADMIN_PASSWORD=changeme_admin_password
ADMIN_USERNAME=admin

# --- PostgreSQL ---
DB_HOST=postgres
DB_PORT=5432
DB_USER=superops
# DB_PASSWORD is what the app connects with; POSTGRES_PASSWORD is what the
# postgres container initialises the role with. They must be identical.
DB_PASSWORD=changeme_db_password
POSTGRES_PASSWORD=changeme_db_password
DB_NAME=superops
DB_SSLMODE=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5
DB_APPLICATION_NAME=superops
DB_STATEMENT_TIMEOUT=30s
DB_LOCK_TIMEOUT=5s
DB_IDLE_IN_TX_TIMEOUT=60s
# Full DSN override, wins over every DB_* above. Use it for a pooler
# (pgbouncer) or to add target_session_attrs. Leave unset for the values above.
#DATABASE_URL=postgres://superops:password@host:5432/superops?sslmode=require

# --- Redis ---
REDIS_ADDR=redis:6379
REDIS_PASSWORD=changeme_redis_password
REDIS_DB=0
REDIS_DIAL_TIMEOUT=2s
REDIS_READ_TIMEOUT=1s
REDIS_WRITE_TIMEOUT=1s
REDIS_POOL_SIZE=20

# --- NATS ---
# The NATS server runs with --user/--pass; docker-compose.yml builds NATS_URL
# from these two values, so do not set NATS_URL here.
NATS_USER=superops
NATS_PASSWORD=changeme_nats_password
NATS_DRAIN_TIMEOUT=10s

# --- JWT ---
JWT_SECRET=changeme_jwt_secret_at_least_32_chars_long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# --- Object storage (uploaded files, and Drive) ---
# FILES_ENABLED=false is the supported way to turn storage off; an empty
# endpoint is treated as unset and falls back to the default.
#
# STORAGE_BACKEND is `minio` (default, what compose runs) or `s3`. The two are
# one implementation — minio-go speaks S3 — with different defaults for
# addressing style and bucket creation. Anything else fails at boot with the
# list of valid values rather than falling through to the default, so a typo
# cannot silently point a production deployment at localhost.
#
# GCS works today through its S3 interoperability endpoint with HMAC keys:
#   STORAGE_BACKEND=s3
#   STORAGE_ENDPOINT=storage.googleapis.com
#   STORAGE_ACCESS_KEY / STORAGE_SECRET_KEY = the HMAC pair
# A native GCS backend would add a dependency for a case this already covers.
#
# On boot, and on demand via POST /api/v1/admin/storage/test, the server round
# trips a marker object: put, get, delete. All three, because they fail
# independently — a bucket policy that allows write and not delete passes every
# reachability check and then makes the object collector a no-op that logs
# success forever.
FILES_ENABLED=true
STORAGE_BACKEND=minio
STORAGE_ENDPOINT=minio:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=changeme_minio_password
STORAGE_BUCKET=superops
STORAGE_USE_SSL=false

# Required by s3 unless STORAGE_ENDPOINT is given explicitly. Not defaulted: a
# bucket reached in the wrong region fails with a redirect that reads as a
# credentials error.
#STORAGE_REGION=eu-west-1

# Unset means "whatever this backend should do" — path style on for minio, off
# for s3; bucket creation on for minio, off for s3 (creating a bucket is an
# account-level action with billing and policy consequences that a service
# account should not take on its own). Set them only to override.
#STORAGE_PATH_STYLE=true
#STORAGE_CREATE_BUCKET=false

# The MINIO_* names below still work and are read when the STORAGE_* name is
# unset, so an existing deployment needs no change.
#MINIO_ENDPOINT=minio:9000
#MINIO_ACCESS_KEY=minioadmin
#MINIO_SECRET_KEY=changeme_minio_password
#MINIO_BUCKET=superops
#MINIO_USE_SSL=false

# --- Meilisearch ---
# SEARCH_ENABLED=false is the supported way to turn search off.
SEARCH_ENABLED=true
MEILI_HOST=http://meilisearch:7700
MEILI_MASTER_KEY=changeme_meili_master_key

# --- Push notifications (Expo) ---
# OFF by default, and deliberately so: enabling it sends the first 140
# characters of every notified message to Expo, and through Expo to Apple and
# Google. Only the worker sends pushes; the API uses this to decide whether to
# expose POST/DELETE /api/v1/users/me/devices at all.
#
# Turning this on is NOT sufficient for a notification to reach a phone. Expo
# fronts APNs and FCM, and it needs real Apple and Google credentials uploaded
# to YOUR Expo project, plus `extra.eas.projectId` in app/app.json so the client
# can obtain a token at all. Without them, tokens register, batches are accepted
# and every message comes back with an `InvalidCredentials` receipt (logged by
# the worker). See https://docs.expo.dev/push-notifications/push-notifications-setup/
PUSH_ENABLED=false
# Expo access token. Only needed if the Expo project has "enhanced push
# security" enabled; leave unset otherwise.
EXPO_ACCESS_TOKEN=
# Overrides Expo's push API endpoint. Leave unset for the default
# (https://exp.host/--/api/v2/push/send); exists for a self-hosted relay.
#EXPO_PUSH_ENDPOINT=
# Bounds one request to the push service.
PUSH_TIMEOUT=15s
# In-process dispatcher sizing in the worker. 0 (or unset) uses the built-in
# defaults: a 4096-message queue and 2 concurrent senders. The queue drops
# rather than blocks when full — a stalled push must never stall event acking.
PUSH_QUEUE_SIZE=0
PUSH_WORKERS=0

# --- Outbound email ---
# Invitations are delivered by email. Without this configured they still work —
# POST /api/v1/admin/invitations keeps returning invite_url — but an admin has
# to copy and paste it by hand.
#
# The transport is a property of the DEPLOYMENT, not a code decision:
#
#   log          Renders the message into the backend/worker log and stops
#                there. THE DEFAULT, so a fresh install cannot mail real people
#                before you opt in. In dev this replaces a mail catcher: the
#                invitation URL is logged under "links".
#   smtp         Authenticated relay. Use this on any cloud host — AWS, GCP,
#                Azure, DigitalOcean and most VPS providers block outbound port
#                25, so direct delivery cannot work there no matter what.
#   smtp-direct  MX lookup and delivery straight to the recipient's server. Only
#                for on-premises, or a host you have confirmed allows outbound
#                25. Needs DKIM (below) plus SPF and a matching PTR record, or
#                the mail will be filed as spam.
#   resend       HTTPS POST to the Resend API, for hosts where even the SMTP
#                submission ports (587/465) are blocked outbound.
#
# ONE transport covers every provider. SES, Postmark, SendGrid, Mailgun, Resend
# and a corporate Exchange relay ALL expose authenticated SMTP, so `smtp` sends
# through any of them — only MAIL_SMTP_HOST and the credentials change. There is
# no per-provider setting and no code change needed to switch. `resend` exists
# only for the blocked-egress case, not because Resend needs special handling.
#
# Selecting a transport and forgetting its required setting fails the boot on
# purpose: mail misconfiguration is otherwise silent, and the first symptom is a
# user who never got their invitation. Verify a live config with
# `POST /api/v1/admin/mail/test`, which sends to the calling admin's own address
# and returns the transport's real error.
MAIL_TRANSPORT=log

# Envelope and header sender. Required by every transport except `log`, and it
# is what SPF and DMARC are evaluated against — use an address on a domain you
# control and have published records for.
MAIL_FROM=superops@company.com
MAIL_FROM_NAME=SuperOps

# Absolute, publicly reachable root of the web client. EVERY link in EVERY
# message is built from it, because a relative "/invite/<token>" in an email is
# not a link at all. A loopback value is rejected at boot for any transport
# other than `log` — no recipient can open http://localhost:8080/invite/...
PUBLIC_BASE_URL=http://localhost:8080
# Appears in subjects and in the message layout.
PRODUCT_NAME=SuperOps

# Bounds one send attempt, whichever transport is selected.
MAIL_TIMEOUT=30s
# Per-IP limit on POST /api/v1/admin/mail/test. Low on purpose: it is an
# outbound-mail trigger, so it does not inherit RATE_LIMIT_API_PER_MIN.
MAIL_TEST_PER_MIN=3

# -- MAIL_TRANSPORT=smtp --
# Host and credentials only. Some known-good values:
#   Amazon SES  email-smtp.<region>.amazonaws.com  587  (SMTP credentials, NOT
#                                                        your AWS access key)
#   Postmark    smtp.postmarkapp.com               587  (server token as both
#                                                        username and password)
#   SendGrid    smtp.sendgrid.net                  587  (username literally
#                                                        "apikey")
#   Mailgun     smtp.<region>.mailgun.org          587
#   Resend      smtp.resend.com                    587  (username "resend")
#MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
#MAIL_SMTP_USERNAME=
#MAIL_SMTP_PASSWORD=
# starttls (587, the default), implicit (465), or none.
# starttls REQUIRES the upgrade: a server that does not offer STARTTLS fails the
# send rather than silently downgrading to plaintext.
MAIL_SMTP_TLS=starttls
# Permit sending credentials over an unencrypted connection. Off by default —
# SMTP AUTH PLAIN is the password in base64. Only for a relay on localhost or a
# trusted private network, and only with MAIL_SMTP_TLS=none.
MAIL_SMTP_ALLOW_INSECURE_AUTH=false
# Skip certificate verification, for a relay whose private CA is not in the
# image's trust store.
MAIL_SMTP_INSECURE_SKIP_VERIFY=false
# Name announced in EHLO. Empty is fine for an authenticated relay, which
# authenticates the session instead of trusting this.
#MAIL_SMTP_HELO=

# -- MAIL_TRANSPORT=smtp-direct (on-premises only) --
# Required: this host's PUBLIC FQDN. Receiving MTAs check it against the
# connecting IP's PTR record, and getting it wrong is one of the cheapest ways
# to be rejected outright.
#MAIL_DIRECT_HELO=mail.company.com
MAIL_DIRECT_PORT=25
# DKIM signing. Optional in the sense that the transport starts without it, and
# mandatory in the sense that unsigned mail from an unfamiliar IP is spam to
# every large mailbox provider — the transport logs a prominent warning when it
# is absent. All three must be set together, or none.
# Generate:  openssl genrsa -out dkim.key 2048
#            openssl rsa -in dkim.key -pubout -outform der | base64 -w0
# then publish the public half as a TXT record at
# <selector>._domainkey.<domain> with value "v=DKIM1; k=rsa; p=<base64>".
#MAIL_DKIM_DOMAIN=company.com
#MAIL_DKIM_SELECTOR=superops
# A PEM block cannot carry its newlines through a .env file, so pass the base64
# of the whole PEM here (`base64 -w0 dkim.key`)...
#MAIL_DKIM_PRIVATE_KEY=
# ...or mount the key and point at it, which is the better shape under Docker
# and the only sane one under Kubernetes. Wins over MAIL_DKIM_PRIVATE_KEY.
#MAIL_DKIM_PRIVATE_KEY_FILE=/run/secrets/dkim.key

# -- MAIL_TRANSPORT=resend --
#MAIL_RESEND_API_KEY=
# Overrides https://api.resend.com/emails. Exists for a proxy; leave unset.
#MAIL_RESEND_ENDPOINT=

# -- Local development --
# `docker compose --profile mail up -d` starts Mailpit, which catches mail
# instead of delivering it and renders it at http://127.0.0.1:8025. Useful for
# seeing the templates as a real client draws them, which `log` cannot show.
# Set MAIL_TRANSPORT=smtp, MAIL_SMTP_HOST=mailpit, MAIL_SMTP_PORT=1025,
# MAIL_SMTP_TLS=none and leave the credentials unset. Development only.

# --- Single sign-on (OIDC) ---
# Empty disables SSO entirely: the /api/v1/auth/sso/* and
# /api/v1/workspaces/{id}/sso routes are not registered at all, and password
# login behaves exactly as it does today.
#
# The per-workspace provider (issuer, client id, client secret, enforcement) is
# configured in the product by a workspace administrator and stored in Postgres.
# This variable is the deployment-level half: it is the AES-256 key that seals
# every tenant's client secret at rest, so without it the feature refuses to
# construct rather than storing those credentials in the clear.
#
# Generate:  openssl rand -hex 32
# Accepted as 64 hex characters, base64 of 32 bytes, or 32 raw characters — a
# value that is none of those fails the boot rather than being silently
# truncated.
#
# TREAT AS A SECRET, and back it up: rotating it makes every stored client
# secret unopenable, and the only fix is re-entering each workspace's secret.
SSO_SECRET_KEY=
#
# Permit an http:// issuer, and an issuer that resolves to a loopback, private
# or link-local address. FOR A LOCAL TEST PROVIDER ONLY, and the boot REFUSES
# this combination unless PUBLIC_BASE_URL is a loopback address: the issuer URL
# comes from a workspace administrator (a tenant, not you), so with this on any
# one of them can point it at 169.254.169.254 and read the cloud metadata
# service — the node's IAM credentials — through this process.
SSO_ALLOW_INSECURE_ISSUER=false
#
# Timeouts and lifetimes. The defaults are shown; all are optional.
# SSO_HTTP_TIMEOUT bounds one call to the provider (discovery, JWKS, token).
SSO_HTTP_TIMEOUT=10s
# How long a started sign-in stays completable (typing a password and a TOTP
# code at the IdP, not a coffee break).
SSO_AUTH_REQUEST_TTL=10m
# Bounds the second step: the 2FA prompt or the account-link challenge.
SSO_PENDING_TTL=5m
# How long a fetched JWKS is served without revalidation. Key rotation does not
# wait for this — an unknown `kid` triggers a throttled refetch.
SSO_JWKS_CACHE_TTL=1h
# Tolerance applied to the ID token's `exp` and `iat`.
SSO_CLOCK_SKEW=2m

# --- CORS ---
# Comma-separated list of allowed browser origins. The default when unset is
# "*", which is wrong for any deployment that serves real users. The bundled
# web client is same-origin behind the nginx proxy, so the proxy origin is all
# you normally need.
CORS_ALLOWED_ORIGINS=http://localhost:8080

# --- Rate limiting ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_API_PER_MIN=600
RATE_LIMIT_AUTH_PER_MIN=10
# Honour X-Forwarded-For for the per-IP limits. ONLY safe when every request
# reaches the backend through a proxy that overwrites that header — i.e. the
# bundled nginx, with the backend port bound to loopback. Set to false if you
# expose the backend port directly, otherwise the login brute-force limit is
# bypassable by rotating the header.
RATE_LIMIT_TRUST_PROXY=true
# Number of trusted proxies in front of the app; the client IP is taken as the
# Nth entry from the RIGHT of X-Forwarded-For. The bundled stack is exactly one
# nginx hop. Only valid together with RATE_LIMIT_TRUST_PROXY=true.
RATE_LIMIT_TRUSTED_PROXY_HOPS=1

# --- Metrics ---
# When set, GET /metrics requires `Authorization: Bearer <token>`. Leave unset
# only on a host where nothing untrusted can reach the backend port. setup.sh
# also writes this value to deploy/docker/secrets/metrics_token for Prometheus.
METRICS_TOKEN=changeme_metrics_token

# --- Monitoring profile (docker compose --profile monitoring) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme_grafana_password

# --- Worker ---
# Port cmd/worker serves GET /health on (job-loop liveness; 503 when a loop has
# stopped ticking). Only the worker container reads it; docker-compose.yml uses
# the same value for the worker healthcheck, and the Helm chart sets it on the
# worker Deployment. Internal to the container — nothing publishes this port.
WORKER_HEALTH_PORT=8081

# --- Logging ---
LOG_LEVEL=info

# --- Unified inbox digest ---
# The unified inbox (`GET /api/v1/inbox`) batches unread items into one email
# per person per workspace. Both windows are policy, not product design.
#
# An item is not mailed until it has been quiet for this long, which is what
# collapses a burst: any new event resets the item's clock and pushes it back
# out of the window.
INBOX_DIGEST_QUIET_PERIOD=10m
# Hard ceiling on digest volume per person per workspace. A user who chooses
# email="immediate" for a notification kind is gated by the same counter, so
# that choice cannot exceed this budget.
INBOX_DIGEST_MIN_INTERVAL=1h

# --- Audit ---
# Deployment-wide retention, enforced by DROPPING monthly partitions rather than
# by a batched DELETE (migration 021). 0 disables retention entirely. There is
# deliberately no per-workspace setting: rows with different lifetimes sharing a
# partition would turn the DROP back into the DELETE this exists to avoid.
AUDIT_RETENTION_DAYS=365

# Off-box anchoring of the per-workspace audit hash chain.
#
# READ THIS BEFORE RELYING ON TAMPER-EVIDENCE. The chain lives in the same
# database as the rows it protects. Anyone with UPDATE on audit_logs — which
# includes anyone with psql and the app's credentials — can recompute the whole
# chain. The chain becomes meaningful only for the entries whose head has been
# shipped somewhere that person cannot rewrite. GET /api/v1/admin/audit-logs/verify
# reports head_seq and anchored_seq per workspace; everything ABOVE anchored_seq
# is protected by nothing but a chain in a database an administrator can edit.
#
#   log  (default) — writes the anchor to this process's log. Useful rather than
#                    a placeholder in any deployment whose log pipeline already
#                    ships off the host, which is most of them. If yours does
#                    not, this is not an anchor.
#   file           — appends NDJSON to AUDIT_SINK_PATH. Meaningful on a host
#                    with an append-only or immutable log volume; on an ordinary
#                    filesystem the same administrator can rewrite it.
#   http           — POSTs to AUDIT_SINK_ENDPOINT with an HMAC-SHA256 signature
#                    in X-SuperOps-Signature. AUDIT_SINK_SECRET is REQUIRED: an
#                    anchor the receiver cannot authenticate is one anybody can
#                    forge.
#
# A transport named without its credentials is a BOOT FAILURE on both the
# backend and the worker, not a first-use failure.
AUDIT_SINK=log
# AUDIT_SINK_PATH=/var/log/superops/audit-anchors.ndjson
# AUDIT_SINK_ENDPOINT=https://siem.example.com/superops/anchors
# AUDIT_SINK_SECRET=changeme_audit_sink_hmac_secret
AUDIT_SINK_TIMEOUT=10s

# Per-IP budget for GET /admin/audit-logs/export and POST /admin/audit-sink/test.
# The export is one request that can return a lot of rows — the highest-value
# single request in the product — so it carries its own limit rather than the
# general API's.
AUDIT_EXPORT_PER_MIN=6

# Tier 2 buffer (file downloads, sensitive reads). Blank uses the built-in
# defaults (4096 deep, 2 workers). A full buffer DROPS, counted and logged, and
# the count is on /metrics as superops_audit_dropped_total — alert on it: the
# buffer fills exactly when the load is interesting.
# AUDIT_BUFFER_SIZE=4096
# AUDIT_BUFFER_WORKERS=2

# ---------------------------------------------------------------------------
# Huddles — live audio and screen sharing (ROADMAP §3c)
# ---------------------------------------------------------------------------
#
# OFF BY DEFAULT and off means ABSENT: with RTC_HOST unset the huddle routes are
# never registered, the client is told the capability is missing, and nothing
# pretends a call is about to work. That is deliberate — an SFU is a second
# server somebody has to run, and a self-hosted product cannot assume one.
#
# Setting SOME of the three below FAILS THE BOOT rather than silently disabling
# the feature. A half-configured media server is a missing feature with no
# explanation, which is the worst of both.
#
# A LiveKit server is the reference implementation:
#   docker compose --profile huddle up -d
#
# RTC_HOST=http://livekit:7880
# RTC_API_KEY=devkey
# RTC_API_SECRET=change-me-to-at-least-32-characters
#
# The webhook is how the participant roster stays truthful. Without it the
# roster is only as fresh as the 30-second reconciler, and the signature is what
# stops a stranger writing who is in your calls — so the route is not registered
# at all unless this is set.
# RTC_WEBHOOK_SECRET=change-me-too
#
# TURN relays, for users behind a symmetric NAT. SEPARATE from the SFU because
# they are separate decisions: an SFU on a public address needs no relays, and a
# corporate firewall needs them even with a healthy SFU.
#
# RTC_ICE_SECRET IS REQUIRED IF ANY URL IS turn: OR turns:. A relay with no
# shared secret is an OPEN RELAY on your network, and the boot refuses it.
# RTC_ICE_URLS=stun:stun.l.google.com:19302,turn:turn.example.com:3478
# RTC_ICE_SECRET=the-coturn-static-auth-secret
# RTC_ICE_TTL=12h
