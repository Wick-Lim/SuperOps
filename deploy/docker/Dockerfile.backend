# Stage 1: Build
FROM golang:1.25-alpine AS builder

RUN apk add --no-cache git

WORKDIR /src
COPY backend/go.mod backend/go.sum ./
RUN go mod download

COPY backend/ .
# Every cmd/ binary ships in this one image; each deployment overrides the
# entrypoint. seed and reindex are one-shot operator tools, but they are the
# only way to run their tasks: seed is the documented demo path (README), and
# reindex is the only way to rebuild the Meilisearch index after a data loss,
# a schema change or a retention purge. Leaving them out of the image made both
# reachable only from a Go toolchain checkout.
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /bin/superops ./cmd/superops && \
    CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /bin/worker ./cmd/worker && \
    CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /bin/migrate ./cmd/migrate && \
    CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /bin/seed ./cmd/seed && \
    CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /bin/reindex ./cmd/reindex

# Stage 2: Runtime
FROM alpine:3.21

RUN apk add --no-cache ca-certificates wget tzdata && \
    addgroup -S superops && adduser -S superops -G superops

COPY --from=builder /bin/superops /app/superops
COPY --from=builder /bin/worker /app/worker
COPY --from=builder /bin/migrate /app/migrate
COPY --from=builder /bin/seed /app/seed
COPY --from=builder /bin/reindex /app/reindex
COPY backend/migrations /app/migrations

USER superops
# 8080: the API server. 8081: cmd/worker's /health endpoint
# (WORKER_HEALTH_PORT), which the Kubernetes probes and the compose healthcheck
# hit.
EXPOSE 8080 8081

ENTRYPOINT ["/app/superops"]
