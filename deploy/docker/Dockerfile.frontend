# Build the React Native Web (Expo) static bundle and serve it with nginx.
# Build context is the repository root.
FROM node:22-alpine AS builder
WORKDIR /app
COPY app/package.json app/package-lock.json ./
RUN npm ci
COPY app/ ./
# Static web export (react-native-web) → /app/dist
RUN npx expo export --platform web --output-dir dist

FROM nginx:1.27-alpine
# Shared snippets: the routing table, the security headers and the upstream are
# defined once and included by both the HTTP and the TLS server config.
COPY deploy/docker/nginx-upstream.conf /etc/nginx/snippets/upstream.conf
COPY deploy/docker/nginx-locations.conf /etc/nginx/snippets/app-locations.conf
COPY deploy/docker/nginx-security-headers.conf /etc/nginx/snippets/security-headers.conf
COPY deploy/docker/nginx-frontend.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=3s CMD wget -qO- http://localhost/ >/dev/null 2>&1 || exit 1
